<?xml version="1.0"?>
<ruleset name="Competitor Price Stock Monitor">
    <description>WordPress Coding Standards for the plugin.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress">
        <!-- WP.org plugin review does not enforce full class-name filenames.
             The plugin uses the conventional class-{purpose}.php naming. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

        <!-- Plugin has a single top-level file; file-level docblock not required. -->
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>

        <!-- Short ternary (?:) is valid PHP 5.3+ and is not a security concern.
             WP.org plugin reviewers do not reject plugins for this style choice. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>

        <!-- manage_woocommerce is a real WooCommerce capability; not an unknown cap. -->
        <exclude name="WordPress.WP.Capabilities.Unknown"/>
    </rule>

    <!-- Verified: base64 is used only for AES-GCM IV/tag/ciphertext encoding,
         not for obfuscation. Allow it explicitly. -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <properties>
            <property name="exclude" type="array">
                <element value="obfuscation"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="competitor-price-stock-monitor"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wc_competitor_monitor"/>
                <element value="WC_Competitor_Monitor"/>
                <element value="CPSM"/>
                <element value="WC_COMPETITOR_MONITOR"/>
            </property>
        </properties>
    </rule>
</ruleset>
